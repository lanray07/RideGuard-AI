    "Estimated time: %lld min. Difference from fastest: %lld min.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée estimée : %lld min. Écart avec le plus rapide : %lld min."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duración estimada: %lld min. Diferencia con la más rápida: %lld min."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschätzte Dauer: %lld Min. Unterschied zur schnellsten Route: %lld Min."
          }
        }
      }
    },
    "Measured protected-lane coverage, major-road distance, junction counts, elevation and traffic are not available in this build.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version ne dispose pas de mesures sur les pistes protégées, les routes principales, les intersections, le dénivelé ou la circulation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no dispone de mediciones de carriles protegidos, distancia por vías principales, cruces, desnivel o tráfico."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version enthält keine Messdaten zu geschützten Radwegen, Hauptstraßenabschnitten, Kreuzungen, Höhenunterschieden oder Verkehr."
          }
        }
      }
    },
    "Compare routes": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparer les itinéraires"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara rutas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Routen vergleichen"
          }
        }
      }
    },
    "Every ride deserves a little more confidence.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque trajet mérite un peu plus de confiance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada trayecto merece un poco más de confianza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Fahrt verdient etwas mehr Zuversicht."
          }
        }
      }
    },
    "Fastest isn’t always your only option.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus rapide n’est pas toujours votre seule option."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta más rápida no siempre es la única opción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die schnellste Route ist nicht immer die einzige Möglichkeit."
          }
        }
      }
    },
    "Know what riders ahead are seeing.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez ce que les cyclistes devant vous observent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre lo que observan los ciclistas que van por delante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfahre, was Radfahrende vor dir beobachten."
          }
        }
      }
    },
    "Someone can know you’re on your way.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informez quelqu’un de votre départ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz saber a alguien que estás en camino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass jemanden wissen, dass du unterwegs bist."
          }
        }
      }
    },
    "Check in without having to remember.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel pour donner de vos nouvelles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio para dar señales de vida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung, dich zu melden."
          }
        }
      }
    },
    "Your location is personal.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position vous appartient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación es personal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort ist privat."
          }
        }
      }
    },
    "Compare cycling route factors, understand rider reports and prepare for your everyday journey.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez les caractéristiques des itinéraires, consultez les signalements et préparez vos trajets quotidiens à vélo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara las características de las rutas, consulta avisos de ciclistas y prepara tus trayectos diarios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche Routeneigenschaften, sieh dir Meldungen an und bereite deine täglichen Fahrten vor."
          }
        }
      }
    },
    "Explore explainable route comparisons. Demo scores are illustrative, never a promise of safety.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorez des comparaisons d’itinéraires expliquées. Les scores de la démo sont fictifs et ne garantissent jamais la sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora comparaciones de rutas con explicaciones. Las puntuaciones de la demo son ejemplos, nunca una garantía de seguridad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkunde nachvollziehbare Routenvergleiche. Demo-Werte dienen der Veranschaulichung und garantieren keine Sicherheit."
          }
        }
      }
    },
    "Mark potholes, roadworks and blocked lanes. Reports in this build stay on your device.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez les nids-de-poule, travaux et pistes obstruées. Dans cette version, les signalements restent sur votre appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra baches, obras y carriles bloqueados. En esta versión, los avisos permanecen en tu dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse Schlaglöcher, Baustellen und blockierte Wege. Meldungen bleiben in dieser Version auf deinem Gerät."
          }
        }
      }
    },
    "Prepare a ride and keep an eye on your ETA. Secure live sharing needs a connected service and is unavailable in this build.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparez un trajet et consultez votre arrivée estimée. Le partage sécurisé en direct nécessite un service connecté et n’est pas disponible dans cette version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara un trayecto y consulta tu llegada estimada. Compartir en directo de forma segura requiere un servicio conectado y no está disponible en esta versión."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereite eine Fahrt vor und behalte die Ankunftszeit im Blick. Sichere Live-Freigabe benötigt einen verbundenen Dienst und ist in dieser Version nicht verfügbar."
          }
        }
      }
    },
    "Set a reminder for an overdue ride. You choose whether to send a check-in using your phone’s sharing options.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programmez un rappel en cas de retard. Vous choisissez de donner ou non de vos nouvelles via les options de partage du téléphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura un recordatorio si te retrasas. Tú decides si envías una confirmación mediante las opciones de compartir del teléfono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte eine Erinnerung bei Verspätung ein. Du entscheidest, ob du über die Teilen-Funktion deines Telefons eine Rückmeldung sendest."
          }
        }
      }
    },
    "Planning uses location on request. Tracking runs only during rides you start. No location is shared automatically. Delete or export local records at any time.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La planification utilise votre position à votre demande. Le suivi fonctionne uniquement pendant les trajets que vous démarrez. Aucune position n’est partagée automatiquement. Supprimez ou exportez vos données locales à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La planificación usa tu ubicación cuando lo solicitas. El seguimiento solo funciona en trayectos que inicies. No se comparte tu ubicación automáticamente. Elimina o exporta los registros locales cuando quieras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Planung nutzt deinen Standort auf Anfrage. Die Aufzeichnung läuft nur während selbst gestarteter Fahrten. Dein Standort wird nicht automatisch geteilt. Lokale Daten kannst du jederzeit löschen oder exportieren."
          }
        }
      }
    },
