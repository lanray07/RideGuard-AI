    "There is not enough current, verified information to calculate a risk score. Missing information does not mean low risk.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas assez d'information à jour et vérifiée pour calculer une cote de risque. Une information manquante ne signifie pas un faible risque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente información actualizada y verificada para calcular una puntuación de riesgo. La falta de información no significa bajo riesgo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt nicht genügend aktuelle, verifizierte Informationen, um einen Risiko-Score zu berechnen. Fehlende Informationen bedeuten kein geringes Risiko."
          }
        }
      }
    },
