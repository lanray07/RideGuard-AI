{
  "sourceLanguage": "en",
  "strings": {
    "Your ride was restored. Tap Resume updates to continue location tracking.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre balade a été restaurée. Appuyez sur Reprendre les mises à jour pour continuer le suivi de l'emplacement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu viaje fue restaurado. Pulsa Resumir las actualizaciones para continuar el seguimiento de ubicación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Fahrt wurde wiederhergestellt. Tippen Sie auf Updates Fortsetzen, um die Standortverfolgung fortzusetzen."
          }
        }
      }
    },
    "Open RideGuard on iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez RideGuard sur iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra RideGuard en iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie RideGuard auf dem iPhone."
          }
        }
      }
    },
    "Local storage is unavailable. Changes cannot be saved.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage local n'est pas disponible. Les changements ne peuvent pas être enregistrés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento local no está disponible. Los cambios no se pueden salvar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Speicherung ist nicht verfügbar. Veränderungen können nicht gerettet werden."
          }
        }
      }
    },
    "A recent location is required. Tap Use my location and try again.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un emplacement récent est nécessaire. Appuyez sur Utiliser mon emplacement et essayez à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere una ubicación reciente. Pulsa Usa mi ubicación e inténtalo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Standort ist erforderlich. Tippen Sie auf Verwenden Sie meinen Standort und versuchen Sie es erneut."
          }
        }
      }
    },
    "Ride started. The check-in reminder could not be scheduled.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La course a commencé. Le rappel d'enregistrement n'a pas pu être programmé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ride empezó. No se puede programar el recordatorio de facturación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fahrt begann. Die Check-in-Erinnerung konnte nicht geplant werden."
          }
        }
      }
    },
    "Ride updates resumed.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi du trajet a repris."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han reanudado las actualizaciones del trayecto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahrtaktualisierungen fortgesetzt."
          }
        }
      }
    },
    "The check-in reminder could not be updated.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rappel d'enregistrement n'a pas pu être mis à jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar el recordatorio de entrada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Check-in-Erinnerung konnte nicht aktualisiert werden."
          }
        }
      }
    },
    "Your ride is taking longer than expected. Are you okay?": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre trajet est plus long que prévu. Ça va ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu viaje es más largo de lo esperado. ¿Estás bien?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Fahrt dauert länger als erwartet. Bist du okay?"
          }
        }
      }
    },
    "Your observation was saved locally.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre observation a été enregistrée sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu observación se ha guardado en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Beobachtung wurde auf diesem Gerät gespeichert."
          }
        }
      }
    },
    "Start a ride to check reports on your route.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez un tour pour vérifier les rapports sur votre itinéraire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comience un viaje para comprobar los informes de su ruta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie eine Fahrt, um Berichte auf Ihrer Route zu überprüfen."
          }
        }
      }
    },
    "Your current location is unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre emplacement actuel n'est pas disponible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su ubicación actual no está disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr aktueller Standort ist nicht verfügbar."
          }
        }
      }
    },
    "No current reports in the next kilometre of available route data. Conditions may be unreported.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun signalement à jour sur le prochain kilomètre de l’itinéraire disponible. Certains dangers peuvent ne pas avoir été signalés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay avisos actuales en el próximo kilómetro de los datos de ruta disponibles. Puede haber condiciones que no se hayan comunicado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine aktuellen Meldungen für den nächsten Kilometer der verfügbaren Route. Mögliche Gefahren wurden eventuell nicht gemeldet."
          }
        }
      }
    },
    "Local history, reports, contacts and preferences deleted.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique local, rapports, contacts et préférences supprimés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia local, informes, contactos y preferencias eliminadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Geschichte, Berichte, Kontakte und Präferenzen wurden gelöscht."
          }
        }
      }
    },
    "RideGuardExport": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RideGuardExport"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RideGuardExport"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RideGuardExport"
          }
        }
      }
    },
    "Looks like you've arrived. Check in when you're ready.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On dirait que vous êtes arrivé. Vérifiez quand vous êtes prêt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que has llegado. Comprueba cuándo estás listo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieht so aus, als wären Sie angekommen. Check-in, wenn du bereit bist."
          }
        }
      }
    },
    "No active ride.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de trajet actif."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay paseo activo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine aktive Fahrt."
          }
        }
      }
    },
    "Okay. Your check-in window has been updated.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Très bien. Votre fenêtre d'enregistrement a été mise à jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale. Su ventana de facturación ha sido actualizada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay. Ihr Check-in-Fenster wurde aktualisiert."
          }
        }
      }
    },
    "Ride ended. No contact message was sent.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trajet terminé. Aucun message n’a été envoyé à vos contacts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trayecto finalizado. No se ha enviado ningún mensaje a tus contactos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahrt beendet. Es wurde keine Nachricht an Kontakte gesendet."
          }
        }
      }
    },
    "Open a ride on iPhone first.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir un tour sur iPhone d'abord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra un paseo en el iPhone primero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie zuerst eine Fahrt auf dem iPhone."
          }
        }
      }
    },
    ")report saved on iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ")rapport enregistré sur iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ") informe guardado en el iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht wird auf dem iPhone gespeichert."
          }
        }
      }
    },
    "No active ride": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de trajet actif"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay paseo activo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine aktive Fahrt"
          }
        }
      }
    },
    "No recent location is available. Open RideGuard and enable location before reporting.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun emplacement récent n'est disponible. Ouvrez RideGuard et activez l'emplacement avant de signaler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ubicación reciente disponible. Abra RideGuard y active la ubicación antes de informar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Standort ist nicht verfügbar. Öffnen Sie RideGuard und aktivieren Sie den Standort vor der Berichterstattung."
          }
        }
      }
    },
    "There is no active RideGuard ride.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun trajet RideGuard n’est en cours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún trayecto de RideGuard en curso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es läuft keine RideGuard-Fahrt."
          }
        }
      }
    },
    "The report could not be saved to this device. Please try again when local storage is available.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport n'a pas pu être enregistré sur cet appareil. Veuillez réessayer lorsque le stockage local est disponible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe no se puede guardar en este dispositivo. Pruebe de nuevo cuando el almacenamiento local está disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht konnte nicht auf diesem Gerät gespeichert werden. Bitte versuchen Sie es erneut, wenn der lokale Speicher verfügbar ist."
          }
        }
      }
    },
