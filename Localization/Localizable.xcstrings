    "Observations lose relevance with age. Confirmations represent local test interactions, not verified community consensus.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les observations perdent de leur pertinence avec l'âge. Les confirmations représentent des interactions d'essai locales et non un consensus communautaire vérifié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las observaciones pierden relevancia con la edad. Las confirmaciones representan interacciones locales de pruebas, no un consenso comunitario verificado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachtungen verlieren mit dem Alter an Relevanz. Bestätigungen stellen lokale Testinteraktionen dar, nicht den verifizierten Konsens der Gemeinschaft."
          }
        }
