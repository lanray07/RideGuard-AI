    "Location is off. You can enable it in iPhone Settings, or explore the demo.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement est arrêté. Vous pouvez l'activer dans les paramètres de l'iPhone, ou explorer la démo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación está fuera. Puede habilitarlo en Ajustes de iPhone, o explorar la demo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
