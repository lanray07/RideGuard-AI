require 'json'
require 'fileutils'

desc 'Upload current app assets and metadata without submitting for review'
lane :store_listing do
  key = app_store_connect_api_key(
    key_id: ENV.fetch('ASC_KEY_ID'),
    issuer_id: ENV.fetch('ASC_ISSUER_ID'),
    key_filepath: File.join(ENV.fetch('RUNNER_TEMP'), "AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8"),
    duration: 1200
  )
  deliver(
    api_key: key,
    app_identifier: 'com.RideGuardAI.app',
    app_version: '1.0',
    skip_binary_upload: true,
    skip_app_version_update: true,
    submit_for_review: false,
    force: true,
    run_precheck_before_submit: false,
    screenshots_path: './fastlane/screenshots',
    overwrite_screenshots: false,
    name: {'en-GB' => 'RideGuard AI'},
    subtitle: {'en-GB' => 'Cycling routes & road reports'},
    primary_category: 'NAVIGATION',
    copyright: '2026 O. Bankole',
    support_url: {'en-GB' => 'https://github.com/lanray07/RideGuard-AI/issues'},
    marketing_url: {'en-GB' => 'https://github.com/lanray07/RideGuard-AI'},
    privacy_url: {'en-GB' => 'https://github.com/lanray07/RideGuard-AI/blob/main/docs/privacy.md'},
    app_review_information: {
      first_name: 'O.', last_name: 'Bankole',
      phone_number: ENV.fetch('APP_REVIEW_PHONE'),
      email_address: ENV.fetch('APP_REVIEW_EMAIL'),
      notes: 'No account or sign-in is required. The app opens with onboarding and visibly labelled demo data. For real cycling routes on iOS 26+, end any demo ride, switch off demo mode in You, then use Explore > Use my location and enter a destination. Demo scores and reports are illustrative. Community publication, live location sharing, automatic contact messaging and paid purchases are not enabled. Manual sharing uses the system share sheet and does not claim verified delivery. RideGuard is not an emergency-response or crash-detection service.'
    }
  )
  app = Spaceship::ConnectAPI::App.find('com.RideGuardAI.app')
  version = app.get_edit_app_store_version(platform: 'IOS')
  UI.user_error!('Expected editable version 1.0') unless version.version_string == '1.0'
  build = Spaceship::ConnectAPI::Build.all(filter: {app: app.id, version: '102', processingState: 'VALID'}).first
  UI.user_error!('Build 102 is not processed and valid') unless build
  version.select_build(build_id: build.id)
  review = version.fetch_app_store_review_detail
  review.update(attributes: {demoAccountRequired: false})
  localizations = version.get_app_store_version_localizations
  status = {app_id: app.id, version: version.version_string, state: version.app_store_state,
            selected_build: version.get_build.version,
            review_contact_present: !review.contact_email.to_s.empty? && !review.contact_phone.to_s.empty?,
            localizations: localizations.map { |loc| {locale: loc.locale, screenshots: loc.get_app_screenshot_sets.map { |set| {display_type: set.screenshot_display_type, count: set.get_app_screenshots.length} } } }}
  FileUtils.mkdir_p('../build')
  File.write('../build/listing-status.json', JSON.pretty_generate(status))
  UI.success('Listing and screenshots uploaded; build selected. No review submission was made.')
end
